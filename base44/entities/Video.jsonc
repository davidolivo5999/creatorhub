{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Music",
        "Gaming",
        "Education",
        "Comedy",
        "News",
        "Sports",
        "Technology",
        "Lifestyle",
        "Other"
      ],
      "default": "Other"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "mux_upload_id": {
      "type": "string"
    },
    "mux_asset_id": {
      "type": "string"
    },
    "playback_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "ready",
        "error"
      ],
      "default": "processing"
    }
  },
  "required": [
    "title"
  ]
}